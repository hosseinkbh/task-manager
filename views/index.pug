doctype html
html
    head
        title Task Manager
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        link(rel="stylesheet", href="/bootstrap.min.css")
        link(rel="stylesheet", href="/footer.css")
        link(rel="stylesheet", href="/index.css")
    body
        .container.mt-4
            h2.text-center.mb-4 Task Manager
            form#signupForm(action="/sign-up" method="POST" class="w-50 mx-auto")
                .row.g-2.justify-content-center
                    .col-auto
                        button.btn.btn-primary(type="button" onclick="window.location='/auth/view/sign-up'") Sign Up
                    .col-auto
                        button.btn.btn-secondary(type="button" onclick="window.location='/auth/view/log-in'") Log In
    footer.footerStyle
        p.footer-p Made By Hossein Khodabandeh ❤️
        a.footer-a(href=`https://www.linkedin.com/in/hossein-khodabandeh/`)
            img.linkedin(src="/linkedin.svg" alt="LinkedIn Logo")
        a.footer-a(href=`https://github.com/hosseinkbh`)
            img.github(src="/github.svg" alt="GitHub Logo")                    