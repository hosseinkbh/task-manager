doctype html
html
    head
        title Task Manager
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        link(rel="stylesheet", href="/bootstrap.min.css")
        link(rel="stylesheet", href="/footer.css")
        link(rel="stylesheet", href="/create.css")
body
    a(href=`/` style=`text-decoration:inherit;`).top-left-text Task Manager
    .container.mt-4
        h2.text-center.mb-4 Create Task
        form#createTaskForm(action="/task/create" method="POST" class="w-50 mx-auto")
            .row.g-2.mt-2
                .col-md-12
                    label(for="title" class="form-label mb-1") Title:
                    input.form-control(type="text" id="title" name="title" minlength="1" maxlength="100" required)
            .row.g-2.mt-2
                .col-md-12
                    label(for="assigne" class="form-label mb-1") Assigne:
                    select.form-control(type="assigne" id="assigne" name="assign")
                        option(value=null , selected=true) not assigned
                        each user in users
                            option(value=user._id) #{user.firstName + " " + user.lastName}
            .row.g-2.mt-2
                .col-md-12
                    label(for="priority" class="form-label mb-1") Priority:
                    select.form-control(type="priority" id="priority" name="priority" required)
                        each Priority in PriorityEnum
                            option(value=Priority, selected=(Priority && Priority == Priority)) #{Priority}
            .row.g-2.mt-2
                .col-md-12
                    label(for="description" class="form-label mb-1") Description:
                    textarea.description.form-control(id="description" minlength="0" maxlength="5000" name="description" rows="10" cols="40")
            .row.mt-3.justify-content-center
                .col-auto
                    button.btn.btn-primary(type="submit") Create
                .col-auto
                    button.btn.btn-danger(type="button" onclick="window.location='/task/board'") Back
    footer.footerStyle
        p.footer-p Made By Hossein Khodabandeh ❤️
        a.footer-a(href=`https://www.linkedin.com/in/hossein-khodabandeh/`)
            img.linkedin(src="/linkedin.svg" alt="LinkedIn Logo")
        a.footer-a(href=`https://github.com/hosseinkbh`)
            img.github(src="/github.svg" alt="GitHub Logo")