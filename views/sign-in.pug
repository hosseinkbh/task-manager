doctype html
html
    head
        title Task Manager
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        link(rel="stylesheet", href="/bootstrap.min.css")
        link(rel="stylesheet", href="/sign-in.css")
        script(type='text/javascript', src='/sign-in.js')
body
    a(href=`/` style=`color:inherit;text-decoration:inherit;`).top-left-text Task Manager
    .container.mt-4
        h2.text-center.mb-4 Sign In
        form#signInForm(action="/auth/sign-in" method="POST" class="w-50 mx-auto")
            .row.g-2
                .col-md-6
                    label(for="firstName" class="form-label mb-1") First Name:
                    input.form-control(type="text" id="firstName" name="firstName" minlength="2" maxlength="20" required)
                .col-md-6
                    label(for="lastName" class="form-label mb-1") Last Name:
                    input.form-control(type="text" id="lastName" name="lastName" minlength="2" maxlength="20" required)
            .row.g-2.mt-2
                .col-md-12
                    label(for="email" class="form-label mb-1") Email:
                    input.form-control(type="string" id="email" name="email" minlength="10" maxlength="70" required)
            .row.g-2.mt-2
                .col-md-12
                    label(for="phoneNumber" class="form-label mb-1") Phone Number:
                    input.form-control(type="tel" id="phoneNumber" name="phoneNumber" minlength="11" maxlength="11" required)
            .row.g-2.mt-2
                .col-md-12
                    label(for="password" class="form-label mb-1") Password:
                    input.form-control(type="password" id="password" name="password" minlength="8" maxlength="30" required)
            .row.g-2.mt-2
                .col-md-12
                    label(for="confirmPassword" class="form-label mb-1") Confirm Password:
                    input.form-control(type="password" id="confirmPassword" name="confirmPassword" minlength="8" maxlength="30" required)
                    span.error-message#passwordError Passwords do not match.
            .row.mt-3.justify-content-center
                .col-auto
                    button.btn.btn-primary(type="submit") Sign In
                .col-auto
                    button.btn.btn-danger(type="button" onclick="window.location='/'") Back