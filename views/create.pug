doctype html
html
  head
    title Task Manager
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css")
    style.
      .form-control {
        padding: 0.4rem;
      }
      .top-left-text {
        position: absolute;
        top: 25px;
        left: 30px;
        font-size: 1.25rem;
        font-weight: bold;
      }
      .error-message {
        color: red;
        font-size: 0.875rem;
        display: none;
      }
      .description {
        width: 100%; 
        height: 120px;
        padding: 10px;
        font-size: 16px;
        border-radius: 5px;
        border: 1px solid #ccc;
      }
  body
    .top-left-text Task Manager
    .container.mt-4
      h2.text-center.mb-4 Create Task
      form#createTaskForm(action="/task/create" method="POST" class="w-50 mx-auto")
        .row.g-2.mt-2
          .col-md-12
            label(for="title" class="form-label mb-1") Title:
            input.form-control(type="text" id="title" name="title" minlength="1" maxlength="100" required)
        .row.g-2.mt-2
          .col-md-12
            label(for="assigne" class="form-label mb-1") Assigne:
            select.form-control(type="assigne" id="assigne" name="assigne" required)
              each user in users
                option(value=user._id, selected=(user && user == user)) #{user.first_name + " " + user.last_name}
        .row.g-2.mt-2
          .col-md-12
            label(for="priority" class="form-label mb-1") Priority:
            select.form-control(type="priority" id="priority" name="priority" required)
              each Priority in PriorityEnum
                option(value=Priority, selected=(Priority && Priority == Priority)) #{Priority}
        .row.g-2.mt-2
          .col-md-12
            label(for="description" class="form-label mb-1") Description:
            textarea.description.form-control(id="description" minlength="0" maxlength="5000" name="description" rows="10" cols="40")
        .row.mt-3.justify-content-center
          .col-auto
            button.btn.btn-primary(type="submit") Create
          .col-auto
            button.btn.btn-danger(type="button" onclick="window.location='/task/board'") Back